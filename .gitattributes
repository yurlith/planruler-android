* text=auto

# Keep Unix entry points executable and free of CRLF on CI/F-Droid builders.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Android and F-Droid source/metadata are normalized for reproducible checkouts.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Bundled store artwork and the Gradle wrapper are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
