# Copy to keystore.properties (which is ignored by Git) for local signing.
# Paths are resolved from the project root.
storeFile=path/to/test-or-production-key.jks
storePassword=replace-me
keyAlias=replace-me
keyPassword=replace-me

# CI may instead provide:
# PLANRULER_KEYSTORE_FILE
# PLANRULER_KEYSTORE_PASSWORD
# PLANRULER_KEY_ALIAS
# PLANRULER_KEY_PASSWORD
